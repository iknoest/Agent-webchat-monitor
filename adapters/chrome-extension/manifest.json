{
  "manifest_version": 3,
  "name": "AgentSignalBar ChatGPT Web Monitor",
  "version": "1.1",
  "description": "Monitors ChatGPT Web status and reports to AgentSignalBar macOS Menu Bar App",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
